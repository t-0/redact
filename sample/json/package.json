{
  "name": "redact",
  "version": "0.1.0",
  "private": true,
  "description": "a minimal terminal IDE",
  "keywords": ["editor", "tui", "rust"],
  "engines": {
    "rust": ">=1.80"
  },
  "panes": [
    { "id": 1, "name": "explorer", "default": true },
    { "id": 2, "name": "source control", "default": false },
    { "id": 3, "name": "tests", "default": false },
    { "id": 4, "name": "debug", "default": false },
    { "id": 5, "name": "problems", "default": false }
  ],
  "limits": { "undoDepth": 1000, "scrollback": 2000, "maxErrors": 200 },
  "unicode": "tabs → spaces, ✓ and ✗",
  "nothing": null
}
